# Secret references resolved via the 1Password CLI.
# Safe to commit: only op:// references, never actual values.
#
# Usage:
#   op run --env-file .env.op -- <command>
#
# Examples:
#   op run --env-file .env.op -- npx tsx scripts/migrate-to-datocms.ts
#
# Prereqs:
#   1. 1Password desktop app installed with CLI integration enabled
#      (Settings → Developer → Integrate with 1Password CLI)
#   2. `op vault list` shows the Nic Murphy vault
#   3. Items exist in the Nic Murphy vault with the field labels referenced below
#
# Netlify builds don't use this file — secrets live in Netlify's own
# Site configuration → Environment variables.

DATOCMS_API_TOKEN="op://Nic Murphy/DATOCMS_API_TOKEN/credential"
